# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Node / Next.js ─────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

/coverage
/.next/
/out/
/build

# ─── Misc ───────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Env files ──────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Vercel ─────────────────────────────────────────────
.vercel

# ─── Convex ─────────────────────────────────────────────
/convex/_generated
.convex/

# ─── Modal ──────────────────────────────────────────────
# Python venv + cached artifacts inside modal/ are local-only.
modal/__pycache__/
modal/.modal/
modal/venv/
modal/.venv/
**/__pycache__/
*.py[cod]

# ─── Editors ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── TypeScript ─────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts
