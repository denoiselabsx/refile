# Copy to .env.local and fill in real values.
# Anything beginning with NEXT_PUBLIC_ is exposed to the browser.

# ─── Convex ─────────────────────────────────────────────
# From the Convex dashboard → your deployment → Settings → URL
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://<your-deployment>.convex.site

# Written by `npx convex dev`. Local-only.
CONVEX_DEPLOYMENT=dev:<your-deployment>

# ─── App ────────────────────────────────────────────────
# Public URL of this frontend. Use http://localhost:3000 for dev,
# your real https URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional ───────────────────────────────────────────
# Only needed for the /api/transcribe voice route (OpenAI Whisper)
# OPENAI_API_KEY=
