# Copy to .env.local and fill in real values.
# Anything beginning with NEXT_PUBLIC_ is exposed to the browser.

# ─── Convex ─────────────────────────────────────────────
# From the Convex dashboard → your deployment → Settings → URL
NEXT_PUBLIC_CONVEX_URL=https://cool-stork-372.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://cool-stork-372.convex.site

# Written by `npx convex dev`. Local-only.
CONVEX_DEPLOYMENT=dev:<your-deployment>

# ─── App ────────────────────────────────────────────────
# Public URL of this frontend. Use http://localhost:3000 for dev,
# your real https URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Polar (billing) ────────────────────────────────────
# See POLAR_SETUP.md for the exact dashboard steps that produce these.
# Start in sandbox; switch POLAR_SERVER to "production" only after testing.
POLAR_SERVER=sandbox
# Organization Access Token (Polar dashboard → Settings → Developers).
POLAR_ACCESS_TOKEN=
# Webhook signing secret (Polar dashboard → Settings → Webhooks).
POLAR_WEBHOOK_SECRET=
# Shared secret guarding the Convex billing bridge mutation. Generate any
# long random string. Set the SAME value here AND on the Convex deployment
# (npx convex env set POLAR_WEBHOOK_BRIDGE_SECRET ...).
POLAR_WEBHOOK_BRIDGE_SECRET=
# Product IDs per paid tier. Global products are full price
# (Student $4 / Pro $7 / Power $20). The *_IN products are the India
# (PPP) priced equivalents (Student $2 / Pro $5 / Power $15) — SAME
# quotas, lower price. Create all six in the Polar dashboard.
POLAR_PRODUCT_STUDENT=
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_POWER=
POLAR_PRODUCT_STUDENT_IN=
POLAR_PRODUCT_PRO_IN=
POLAR_PRODUCT_POWER_IN=
# Event name the conversions meter filters on. Must match the meter's
# filter in the Polar dashboard. Default is fine; keep it in sync.
POLAR_CONVERSION_EVENT=conversion
# Also set POLAR_ACCESS_TOKEN + POLAR_SERVER on the Convex deployment
# (npx convex env set) so runJob can ingest usage events.

# ─── Optional ───────────────────────────────────────────
# Only needed for the /api/transcribe voice route (OpenAI Whisper)
# OPENAI_API_KEY=
